# ===================================
# Переменные окружения Arabuthka
# ===================================
# Скопируй этот файл как .env и заполни своими данными
# ===================================

# Telegram-бот (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# URL веб-приложения на Vercel
WEBAPP_URL=https://arabutka-webapp.vercel.app

# PostgreSQL база данных (Railway даёт автоматом)
DATABASE_URL=

# Cloudinary (хранилище аудио)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Webhook URL для Telegram-бота (адрес сервиса на Railway)
WEBHOOK_URL=https://your-telegram-service.up.railway.app
