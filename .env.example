# ===================================
# Переменные окружения Arabuthka
# ===================================
# Скопируй этот файл как .env и заполни своими данными
# ===================================

# ----------------
# Telegram Bot
# ----------------
# Токен бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# ----------------
# Web Application
# ----------------
# URL веб-приложения на Vercel
WEBAPP_URL=https://arabutka-webapp.vercel.app

# ----------------
# Database
# ----------------
# PostgreSQL база данных (Railway даёт автоматом)
DATABASE_URL=

# ----------------
# Cloudinary (хранилище аудио)
# ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------
# Telegram Webhook
# ----------------
# Webhook URL для Telegram-бота (адрес сервиса на Railway)
WEBHOOK_URL=https://your-telegram-service.up.railway.app

# ----------------
# Server Configuration
# ----------------
# Порт для API сервера (по умолчанию 3000)
PORT=3000

# Режим окружения (development / production)
NODE_ENV=production

# ----------------
# Monitoring & Error Tracking
# ----------------
# Sentry DSN для мониторинга ошибок (опционально)
# SENTRY_DSN=

# ----------------
# Rate Limiting
# ----------------
# Максимальное количество запросов в минуту (по умолчанию 100)
# RATE_LIMIT_MAX=100

# ----------------
# File Upload
# ----------------
# Максимальный размер загружаемого файла в MB (по умолчанию 25)
# MAX_FILE_SIZE_MB=25
