# ==================================================
# Arabuthka Bot - Шаблон переменных окружения
# ==================================================
# Скопируй этот файл в .env и заполни реальными значениями
# НИКОГДА не коммить .env в репозиторий!

# --------------------------------------------------
# Telegram Bot Настройки
# --------------------------------------------------
# Токен бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# --------------------------------------------------
# Telegram Mini App Настройки
# --------------------------------------------------
# URL вашего фронтенда (для Mini App)
APP_URL=https://your-frontend-domain.vercel.app

# --------------------------------------------------
# База данных PostgreSQL (Railway/Supabase)
# --------------------------------------------------
# Строка подключения к БД
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# --------------------------------------------------
# Сервер Настройки
# --------------------------------------------------
# Порт для Express сервера (опционально, Railway сам задаёт)
PORT=3000

# Режим работы: development | production
NODE_ENV=development

# --------------------------------------------------
# Логирование (опционально)
# --------------------------------------------------
# Уровень логов: debug | info | warn | error
LOG_LEVEL=info

# --------------------------------------------------
# CORS Настройки (опционально)
# --------------------------------------------------
# Разрешённые источники (через запятую)
CORS_ORIGINS=https://your-frontend.vercel.app,https://web.telegram.org

# --------------------------------------------------
# Rate Limiting (опционально)
# --------------------------------------------------
# Максимум запросов в окно
RATE_LIMIT_MAX=100
# Окно в миллисекундах (15 минут)
RATE_LIMIT_WINDOW_MS=900000

# --------------------------------------------------
# Selectel S3 (Object Storage)
# --------------------------------------------------
# Access Key и Secret Key сервисного пользователя Selectel
S3_ACCESS_KEY=your_selectel_access_key
S3_SECRET_KEY=your_selectel_secret_key
# Имя бакета
S3_BUCKET_NAME=maneshkin
# Endpoint Selectel S3
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
