{
  "name": "arabuthka-server",
  "version": "1.0.0",
  "description": "Arabuthka API server - music streaming and personal library backend",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --verbose",
    "test:ci": "jest --ci --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "audit:cloudinary": "node scripts/audit-cloudinary.js",
    "migrate:cloudinary": "node scripts/migrate-cloudinary-urls.js",
    "migrate:cloudinary:dry": "node scripts/migrate-cloudinary-urls.js --dry-run",
    "verify:urls": "node scripts/verify-track-urls.js"
  },
  "dependencies": {
        "@aws-sdk/client-s3": "^3.0.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "@sentry/node": "^7.99.0",
    "@sentry/profiling-node": "^1.3.4",
    "@distube/ytdl-core": "^4.16.11",
    "ytsr": "^3.8.4",
    "winston": "^3.11.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "@types/node": "^20.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kansayred/arabuthka.git"
  },
  "author": "Arabuthka Team",
  "license": "PROPRIETARY"
}
